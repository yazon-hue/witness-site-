# Helius API key (free at https://dashboard.helius.dev). Powers Explore, evidence checks,
# watchlist activity and sending launch transactions.
HELIUS_API_KEY=

# Pinata JWT (https://app.pinata.cloud → API Keys). Needed only for coin launches.
PINATA_JWT=

# Optional: use a different Solana RPC instead of Helius's.
# RPC_URL=

# Optional: where the SQLite database lives. On Railway this is set automatically from the volume.
# DATABASE_PATH=./data/witness.db
